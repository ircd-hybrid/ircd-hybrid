/*! \file conf_lexer.l
 * \brief Scans the ircd configuration file for tokens.
 */

%option case-insensitive
%option noyywrap
%option noinput
%option nounput
%option never-interactive

%x IN_COMMENT

%{
#include <assert.h>
#include <errno.h>
#include <limits.h>
