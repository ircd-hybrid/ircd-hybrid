#include "defaults.h"
#include "ircd_defs.h"

#undef YY_INPUT
#define YY_INPUT(buf,result,max_size) \
  do { (result) = _conf_lexer_read((buf), (max_size)); } while (0)


unsigned int conf_line_number = 1;
char conf_line_text[IRCD_BUFSIZE];
char conf_file_name[IRCD_BUFSIZE];

enum { MAX_INCLUDE_DEPTH = 5 };
static unsigned int include_stack_ptr;
static char *string_buffer;
static size_t string_capacity;

static struct included_file
{
  YY_BUFFER_STATE state;
  unsigned int conf_line_number;
  FILE *file;
  char conf_file_name[IRCD_BUFSIZE];
  char conf_line_text[IRCD_BUFSIZE];
} include_stack[MAX_INCLUDE_DEPTH];


static void conf_include(void);
static bool conf_eof(void);
static void _conf_lexer_error(const char *, ...) IO_AFP(1, 2);

/* Literal values remain valid until the next QSTRING or scanner cleanup. */
static char *
_conf_lexer_decode_string(const char *text, size_t length)
{
  const size_t capacity = length - 1;
  if (capacity > string_capacity)
  {
    string_buffer = io_realloc(string_buffer, capacity);
    string_capacity = capacity;
  }

  const char *src = text + 1;
  const char *const end = text + length - 1;
  char *dst = string_buffer;

  while (src < end)
  {
    if (*src == '\\')
      ++src;
    *dst++ = *src++;
  }

  *dst = '\0';
  return string_buffer;
}

static void
_conf_lexer_error(const char *format, ...)
{
  conf_parser_ctx.parse_valid = false;

  char message[IRCD_BUFSIZE];
  va_list args;
  va_start(args, format);
  vsnprintf(message, sizeof(message), format, args);
  va_end(args);

  conf_error_report(message);
}

static int
_conf_lexer_read(char *buf, int size)
{
  for (;;)
  {
    errno = 0;
    const size_t length = fread(buf, 1, (size_t)size, conf_parser_ctx.conf_file);
    const int error = errno;

    if (ferror(conf_parser_ctx.conf_file))
    {
      if (error != EINTR)
      {
        _conf_lexer_error("Unable to read configuration file: %s", strerror(error ? error : EIO));
        return 0;
      }

      clearerr(conf_parser_ctx.conf_file);
      if (length == 0)
        continue;
    }

    if (memchr(buf, '\0', length))
    {
      _conf_lexer_error("NUL byte in configuration file");
      return 0;
    }

    return (int)length;
  }
}

%}

WS        [[:blank:]]*
DIGIT     [[:digit:]]+
COMMENT   ("//"|"#").*
qstring   \"([^\"\\\n]|\\[^\n])*\"
unclosed  \"([^\"\\\n]|\\[^\n])*\\?
include   \.include{WS}(\<[^>\n]*\>|\"[^\"\n]*\")

%%

"/*"                { BEGIN IN_COMMENT; }
<IN_COMMENT>"*/"    { BEGIN INITIAL;    }
<IN_COMMENT>.       ;  /* Eat everything but a newline */
<IN_COMMENT>\n      { ++conf_line_number; }
<IN_COMMENT><<EOF>> { _conf_lexer_error("Unterminated comment"); BEGIN INITIAL; if (conf_eof()) yyterminate(); }

{include}       { conf_include(); }
\n.*            { strlcpy(conf_line_text, yytext + 1, sizeof(conf_line_text)); ++conf_line_number; yyless(1); }
{WS}            ;
{COMMENT}       ;
{DIGIT}         {
                  unsigned int value;
                  if (io_parse_uint_range(yytext, 0, INT_MAX, &value) != IO_PARSE_OK)
                  {
                    _conf_lexer_error("Integer literal out of range");
                    return YYerror;
                  }

                  yylval.number = (int)value;
                  return NUMBER;
                }
{qstring}       {
                  yylval.string = _conf_lexer_decode_string(yytext, (size_t)yyleng);
                  return QSTRING;
                }
{unclosed}      {
                  _conf_lexer_error("Unterminated character string");
                  return YYerror;
                }

